# Las direcciones de prueba de Cloudflare no se indexan: Google solo tiene que ver digitalnika.com
https://nika-web-2t0.pages.dev/*
  X-Robots-Tag: noindex
https://:version.nika-web-2t0.pages.dev/*
  X-Robots-Tag: noindex

/firma.html
  X-Robots-Tag: noindex

/img/*
  Cache-Control: public, max-age=604800
/firma/*
  Cache-Control: public, max-age=604800

# Conceptos para clientes: se comparten por link, no se indexan
/conceptos/*
  X-Robots-Tag: noindex, nofollow
